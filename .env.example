# Hash configuration template. Copy to .env (or your orchestrator's secret
# store) and fill in; never commit real .env files. See DEPLOY.md for the full
# deployment guide.
#
# Markers below:
#   [required]      boot fails without it (every environment)
#   [required-prod] boot fails without it unless HASH_ENVIRONMENT=development
#                   and HASH_PUBLIC_URL is loopback / *.localhost / *.local
#   [optional]      feature stays off / falls back to the shown default when unset
# Configuration is parsed by internal/config/; see feature-specific requirements below.

# ---------------------------------------------------------------------------
# HTTP
# ---------------------------------------------------------------------------
HASH_PORT=8080
# [required] Public base URL. Loopback / *.local hosts are eligible for dev
# mode only when HASH_ENVIRONMENT is explicitly `development`.
HASH_PUBLIC_URL=https://esign.example.com
HASH_LOG_LEVEL=info
# [required-prod] Exact lowercase full Git object ID (40 or 64 hexadecimal
# characters) selected for this deployment. Published on /health and attached
# to telemetry so external cutover checks can reject a stale proxy target.
HASH_RELEASE=<full-commit-object-id>
# [required] Runtime security mode as well as telemetry label. Omitted values
# fail closed to production. Development relaxations require the exact value
# `development` AND a loopback/*.localhost/*.local public URL.
HASH_ENVIRONMENT=production
# [required-prod] Independent 32-byte secret, hex-encoded. Caddy overwrites it
# into X-Hash-Proxy-Auth before forwarding your canonical hostname; Hash rejects
# every non-loopback production request without it. Supply the same value to your
# reverse proxy through its protected environment. Never commit it. Generate:
#   openssl rand -hex 32
HASH_PROXY_AUTH=<64-hex-character-independent-proxy-secret>

# ---------------------------------------------------------------------------
# Signer-facing operator identity (GDPR Article 13)
# ---------------------------------------------------------------------------
# [required-prod] Factual legal/operator name for this deployed Hash instance.
# This is shown as the processor/instance operator; it is not necessarily
# Bright Interaction in a self-hosted deployment.
HASH_OPERATOR_NAME=Example Hash Operator AB
# [required-prod] One plain email address monitored for privacy requests.
HASH_PRIVACY_CONTACT=privacy@example.com
# [required-prod] Authority applicable to this operator/deployment, including
# jurisdiction where needed to disambiguate it (for example, "IMY, Sweden").
HASH_SUPERVISORY_AUTHORITY=Applicable Data Protection Authority, Country
# [required-prod] Absolute HTTPS policy published by this deployment's actual
# operator. Do not leave the bundled Bright Interaction policy on self-hosts.
HASH_PRIVACY_POLICY_URL=https://example.com/privacy
# Explicit local development may omit these and receives visibly local-only
# defaults. Staging and production fail boot if any value is absent/invalid.

# ---------------------------------------------------------------------------
# Database (Postgres)  [required]
# ---------------------------------------------------------------------------
# Production requires at least three pool slots (singleton lease, signer
# clarification lock, and its independent durable audit transaction). pgx's
# default exceeds this; if explicitly tuning, append &pool_max_conns=3 or more.
HASH_DB_URL=postgres://hash:changeme@database.example.com:5432/hash?sslmode=verify-full&pool_max_conns=8

# Portable production Compose (docker-compose.selfhost.yml). These are paths,
# not secrets. Keep .env and both complete 17-key work profiles private (0600).
# Images must be the exact independently tested application/renderer artifacts.
# HASH_IMAGE=<approved-local-image-ID-or-registry-digest>
# HASH_GOTENBERG_IMAGE=<approved-renderer-image-ID-or-registry-digest>
HASH_ENV_FILE=.env
HASH_SERVER_WORK_ENV_FILE=.env.work-runtime.server
HASH_WORKER_WORK_ENV_FILE=.env.work-runtime.worker
HASH_MALWARE_SOCKET_DIR=<private-host-directory-containing-clamd.sock>
HASH_HTTP_PORT=8080

# ---------------------------------------------------------------------------
# Work admission, explicit per-process allocations; see docs/WORK-RUNTIME.md.
# ---------------------------------------------------------------------------
# Admission-dependent authoring/signing requires all 17 keys together. With all
# absent, startup/authentication/health may work while those journeys refuse work.
# Keep unused assignments commented: present-but-empty values fail startup.
# Set server and worker allocations separately and account for the actual pool
# maximum plus direct SQL sessions. These are ceilings, not measured capacity.
# Base Compose does not forward these from .env; use the documented opt-in overlay.
# HASH_WORK_GLOBAL_PARENT_BYTES=<explicit allocation>
# HASH_WORK_GLOBAL_DB_STAGING_BYTES=<explicit allocation>
# HASH_WORK_GLOBAL_CHILD_ADDRESS_BYTES=<explicit allocation>
# HASH_WORK_GLOBAL_PDF_WORKERS=<explicit allocation>
# HASH_WORK_GLOBAL_SQL_SESSIONS=<explicit allocation>
# HASH_WORK_GLOBAL_PROVIDER_STREAMS=<explicit allocation>
# HASH_WORK_GLOBAL_RENDERER_REQUESTS=<explicit allocation>
# HASH_WORK_ORG_PARENT_BYTES=<explicit allocation>
# HASH_WORK_ORG_DB_STAGING_BYTES=<explicit allocation>
# HASH_WORK_ORG_CHILD_ADDRESS_BYTES=<explicit allocation>
# HASH_WORK_ORG_PDF_WORKERS=<explicit allocation>
# HASH_WORK_ORG_SQL_SESSIONS=<explicit allocation>
# HASH_WORK_ORG_PROVIDER_STREAMS=<explicit allocation>
# HASH_WORK_ORG_RENDERER_REQUESTS=<explicit allocation>
# HASH_WORK_MAX_GRANTS=<explicit allocation>
# HASH_WORK_MAX_ORG_GRANTS=<explicit allocation>
# HASH_WORK_DB_CONNECTION_ALLOCATION=<explicit allocation>

# ---------------------------------------------------------------------------
# Object storage (MinIO / S3)
# ---------------------------------------------------------------------------
HASH_S3_ENDPOINT=s3.example.com   # [required]
HASH_S3_REGION=eu-central-1                  # [optional] default eu-central-1
HASH_S3_BUCKET=hash                       # [optional] default hash
HASH_S3_ACCESS_KEY=changeme                  # [required]
HASH_S3_SECRET_KEY=changeme                  # [required]
HASH_S3_USE_SSL=true                         # [optional] default true
HASH_S3_SSE_MODE=sse-s3                      # [optional] sse-s3 (default) | sse-c
# Required only for sse-c. This is an absolute path inside each Hash container to a
# read-only file containing exactly 32 RAW random bytes. Do not put the key
# itself here; hex/base64 text and newline-terminated files fail validation.
HASH_S3_SSE_C_KEY_FILE=
# Required only for sse-c. Exact lowercase SHA-256 of the 32 raw bytes in the
# mounted key file; this is a non-secret fingerprint, never the key bytes.
HASH_S3_SSE_C_KEY_SHA256=
HASH_S3_BUCKET_LOOKUP=auto                   # [optional] auto (default) | path | dns
# [required-prod storage policy] The existing HASH_S3_BUCKET must have S3
# Object Lock enabled. Hash writes signed agreements/evidence with seven-year
# COMPLIANCE retention and reads it back. The app principal therefore needs
# GetObjectLockConfiguration, PutObjectRetention, and GetObjectRetention in
# addition to ordinary object read/write permissions, plus narrowly scoped
# DeleteObjectVersion for exact draft/compensating cleanup, the transient
# storage check, and only the `_hash/bootstrap-estate/v1` control key. That
# control-key scope makes the retained marker's denied-delete probe distinguish
# Object Lock from a generic IAM denial. Do not grant/use key-only DeleteObject;
# a delete marker can hide a concurrent version. Missing
# support or permissions fail server and worker startup; lifecycle expiry is
# not a legal-retention substitute. Explicit local development uses its
# disposable bucket without Object Lock.
# SSE-C additionally requires HASH_S3_USE_SSL=true. Hash sends the customer
# encryption headers on every object PUT, GET, and HEAD/Stat operation and
# disables direct browser-presigned downloads so the key never reaches a URL or
# browser. Mount the same key file read-only into server, worker, configcheck,
# auditverify, and every recovery job that reads these objects.

# ---------------------------------------------------------------------------
# SMTP (outbound email; drained by the worker's email-dispatch loop)
# [required-prod] HASH_SMTP_HOST and HASH_SMTP_FROM are required outside
# explicit development. The worker initializes a real SMTP client in every
# environment, so a full development server+worker stack also needs an SMTP
# endpoint; the bundled Compose stack provides MailHog at mailhog:1025.
# HASH_SMTP_USER and HASH_SMTP_PASSWORD must be set together or both left blank.
# Port 1025 is development-only; non-development SMTP uses mandatory STARTTLS.
# ---------------------------------------------------------------------------
HASH_SMTP_HOST=mail.example.com
HASH_SMTP_PORT=587
HASH_SMTP_USER=hash@example.com
HASH_SMTP_PASSWORD=changeme
HASH_SMTP_FROM=Hash <esign@example.com>

# ---------------------------------------------------------------------------
# Optional staff OIDC SSO. Email/password login does not require an IdP.
# Leave these blank unless enabling an existing provider registration.
# ---------------------------------------------------------------------------
HASH_OIDC_ISSUER=
HASH_OIDC_CLIENT_ID=
HASH_OIDC_CLIENT_SECRET=
HASH_OIDC_REDIRECT_URL=

# ---------------------------------------------------------------------------
# Cryptographic keys
# ---------------------------------------------------------------------------
# [required] 32 random bytes hex-encoded (64 hex chars) for HMAC of magic-link
# signer tokens. Rejected if < 32 chars or all-identical. Generate:
#   openssl rand -hex 32
HASH_SIGNER_TOKEN_KEY=changeme_64_hex_chars_for_hmac_of_signer_magic_link_tokens_aaaa
# [required] 32-byte session-cookie key, hex-encoded (same entropy rules).
HASH_SESSION_KEY=changeme_64_hex_chars_for_session_cookie_signing_a_a_a_a_a_a_aa
# [required-prod] Raw 32-byte ed25519 seed (base64) for signing audit certificates.
# Without a stable key, certs signed before a restart can't be verified. The
# server + worker MUST share the same key. Generate:
#   openssl genpkey -algorithm ed25519 -outform DER | tail -c 32 | base64
HASH_AUDIT_PRIVATE_KEY=changeme_base64_encoded_ed25519_private_key
# [optional] Comma-separated base64 raw 32-byte Ed25519 public keys from
# retired/rotation-era Hash audit signers. The current private key's public key
# is trusted automatically. Keep historical issuers here while their ceremony
# certificates must verify; an empty entry or malformed/wrong-length key fails
# boot. These retired keys authenticate historical certificates only. They are
# deliberately NOT accepted as signers of a newly exported evidence manifest;
# fresh manifests are trusted only under the current audit signer's public key.
HASH_AUDIT_TRUSTED_PUBLIC_KEYS=

# ---------------------------------------------------------------------------
# Webhooks (outbound, HMAC-signed)
# ---------------------------------------------------------------------------
# [required] Dedicated AES-256-GCM key used to encrypt each endpoint's exact
# 64-byte ASCII-hex signing secret at rest. Server and worker MUST share it.
# It must be 32 random bytes encoded as exactly 64 hex characters, must not be
# reused for any other Hash purpose, and must be retained with database backups.
# Generate: openssl rand -hex 32
HASH_WEBHOOK_ENCRYPTION_KEY=
# [optional] Prior 32-byte encryption key during a controlled key rotation.
# Set it on server and worker with the new current key, restart both, wait for
# startup backfill/rewrap to finish, verify zero legacy rows, then remove it on
# the next coordinated restart.
HASH_WEBHOOK_ENCRYPTION_KEY_PREVIOUS=
# [migration-only] Legacy global signing secret used only for old endpoint rows
# whose per-endpoint plaintext secret is empty. Leave blank for a fresh install.
# When required for a legacy cutover, it must be at least 32 non-identical
# characters and match the verifier already configured at every affected receiver.
HASH_WEBHOOK_SECRET=
# [deprecated] Retained for old deployment manifests; endpoint encryption-key
# rotation uses HASH_WEBHOOK_ENCRYPTION_KEY_PREVIOUS instead.
HASH_WEBHOOK_SECRET_PREVIOUS=

# ---------------------------------------------------------------------------
# Gotenberg (HTML -> PDF renderer)
# ---------------------------------------------------------------------------
HASH_GOTENBERG_URL=http://gotenberg:3000   # [optional] default http://gotenberg:3000
# Development docker-compose.yml uses gotenberg:3000. Public production
# docker-compose.selfhost.yml forces http://renderer:3000; the private legacy
# production profile uses http://hash-gotenberg:3000. Do not combine profiles.
# Public/legacy production require this token; development permits empty and
# leaves fitted preparation unavailable until explicitly configured.
# Independent private renderer credential: 32-128 printable nonspace ASCII
# characters (for example, 32 random bytes encoded as 64 hex characters).
# App, worker and renderer must receive the same stable value. Compose projects
# only this key into the renderer, never the app environment or other secrets.
# Only the development profile permits an empty token.
HASH_SIGNATURE_FIT_TOKEN=

# ---------------------------------------------------------------------------
# Variable-resolver integrations (Phase 8.2). [optional] empty = source off.
# ---------------------------------------------------------------------------
HASH_BRIGHTCRM_URL=
# [optional operator-only] Empty preserves public-only production egress.
# Nonempty selects a separate strict HTTPS-origin/port lane: at most16 distinct
# canonical private/CGNAT host prefixes (/32 or /128), comma-separated, no spaces.
# Loopback/link-local/known metadata remain denied even when listed. No dev bypass,
# public fallback, environment proxy, redirect or TLS verification exception.
# Provision actual approved destinations/CA and qualify the private-network and
# account/read journey first. See docs/CRM-CONNECTOR.md; no live pins are supplied.
HASH_BRIGHTCRM_TRUSTED_PRIVATE_CIDRS=
# [required together with BRIGHTCRM_URL] Dedicated 32-byte random AES key as
# 64 hex characters. Never reuse a session, signer, webhook or AI key.
# Each organization owner enrolls its own CRM key through Settings/Integrations.
HASH_CRM_ENCRYPTION_KEY=
HASH_CRM_ENCRYPTION_KEY_PREVIOUS=  # optional old key during an explicit re-enrollment window
# HASH_BRIGHTCRM_TOKEN and HASH_BRIGHTCRM_WEBHOOK_SECRET are retired; nonempty
# values refuse startup. Legacy callbacks remain disabled pending a tenant-bound
# producer contract. No shared credential or automatic OAuth fallback.
HASH_SCANNER_URL=
HASH_SCANNER_TOKEN=

# ---------------------------------------------------------------------------
# AI runtime (Phase 8.4). All [optional]; empty provider key = provider off.
# In production, if ANY provider key is set: Shield MUST be enabled (64-hex
# key) AND the provider base URL host MUST be on the EU allow-list, or boot
# fails (PII never reaches a non-EU LLM endpoint).
# ---------------------------------------------------------------------------
# 64 hex chars (32 bytes). Tokenizes PII before any LLM call; also encrypts
# per-org BYOAI keys at rest. Generate: openssl rand -hex 32
HASH_AI_SHIELD_KEY=
HASH_AI_DEFAULT_PROVIDER=mistral       # [optional] mistral (default) | anthropic
# [required-prod when HASH_MISTRAL_API_KEY is set] Use an EU endpoint such as
# https://api.mistral.ai/v1/chat/completions. Blank defaults at runtime to the
# global https://openrouter.ai/api/v1/chat/completions endpoint, which production
# deliberately rejects because it is not on Hash's EU allow-list.
HASH_MISTRAL_BASE_URL=
HASH_MISTRAL_API_KEY=
HASH_MISTRAL_MODEL=
HASH_ANTHROPIC_BASE_URL=               # must resolve to eu.anthropic.com in prod
HASH_ANTHROPIC_API_KEY=
HASH_ANTHROPIC_MODEL=
# Comma-separated extra EU-compliant hostnames/suffixes (e.g. a self-hosted
# LLM in the VPC). Built-ins: api.mistral.ai, eu.anthropic.com, eu.openrouter.ai.
HASH_AI_EU_HOSTS_ALLOWLIST=

# ---------------------------------------------------------------------------
# AES / QES (higher-assurance signature tiers) — unavailable in this release.
# ---------------------------------------------------------------------------
# HASH_QES_PROVIDER MUST remain empty in every environment. Hash rejects any
# configured provider until it persists the exact document digest and
# cryptographically binds/consumes provider proof atomically. The remaining
# names are reserved for that future implementation and do not enable QES.
HASH_QES_PROVIDER=
HASH_QES_IDURA_BASE_URL=https://api.idura.se
HASH_QES_IDURA_API_KEY=
HASH_QES_IDURA_TENANT=
HASH_QES_TRUST_LIST_PATH=

# ---------------------------------------------------------------------------
# Evidence bundle OpenTimestamps experiment (development only).
# The built-in public verifier does not parse or validate OTS calendar proofs.
# Staging and production therefore reject HASH_EVIDENCE_OTS_ENABLED=true; do
# not make timestamp-authority claims from this experimental field. When OFF,
# certificate times are the configured Hash issuer's server-clock assertions.
# ---------------------------------------------------------------------------
HASH_EVIDENCE_OTS_ENABLED=false
HASH_EVIDENCE_OTS_ENDPOINT=

# ---------------------------------------------------------------------------
# Compliance feed (Phase 12.2). [optional] empty = EDPB rollup loop off.
# ---------------------------------------------------------------------------
HASH_COMPLIANCE_FEED_URL=

# ---------------------------------------------------------------------------
# Billing. Production supports operator (self-hosted) or optional Mollie.
# ---------------------------------------------------------------------------
# 'mock' accepts unauthenticated webhooks (dev/e2e only).
HASH_BILLING_PROVIDER=operator                      # self-hosted; mock is dev-only
# Required only for operator mode: reviewed org-to-active-finite-plan bindings.
# Use your actual organization UUID and an explicit operator review reference.
# HASH_OPERATOR_ENTITLEMENTS=[{"org_id":"00000000-0000-0000-0000-000000000000","plan_slug":"pro","review_ref":"review-reference"}]
# The nil example UUID is intentionally invalid. The seeded pro plan is finite
# and enables MCP/branding/evidence; prepare its M95 measurement before authoring.
# See docs/INTERNAL-OPERATOR-MODE.md and docs/CATALOG-MAINTENANCE.md.
HASH_MOLLIE_API_KEY=                                  # [required-prod when provider=mollie]
HASH_MOLLIE_BASE_URL=https://api.mollie.com/v2        # [optional] default shown
# [required-prod when provider=mollie] 16-128 URL-safe characters; embedded in
# the webhook URL so /webhooks/billing/<secret> is unguessable. Generate:
#   openssl rand -hex 32
HASH_MOLLIE_WEBHOOK_PATH_SECRET=

# Required outside explicit development. Private clamd Unix socket mounted
# into Hash; daemon must run TZ=UTC with signatures refreshed within 48h.
# Configure StreamMaxLength >= 160MiB and keep its socket inaccessible to tenants.
HASH_MALWARE_SOCKET=

# Production defaults to the bundled Linux isolated PDF parser. Only explicit
# development may omit it; an explicitly configured broken worker fails closed.
HASH_PDF_WORKER=
