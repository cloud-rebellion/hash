  "components": {
    "securitySchemes": {
      "BearerKey": {
        "type": "http",
        "scheme": "bearer",
        "description": "Hash API key; organization-wide sender/owner, write:authoring plus write:workflow."
      },
      "HeaderKey": {
        "type": "apiKey",
        "in": "header",
        "name": "X-API-Key",
        "description": "Alternative to Authorization bearer."
      }
    },
    "schemas": {
      "SignatureRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "template_id",
          "template_version",
          "template_content_sha256",
          "name",
          "recipients",
          "lawful_basis"
        ],
        "properties": {
          "template_id": {
            "type": "string",
            "format": "uuid",
            "description": "Accessible nonzero UUID of a valid block-source template. Whitespace is trimmed."
          },
          "name": {
            "type": "string",
            "description": "Trimmed nonempty plain text without control characters; at most 1000 UTF-8 bytes.",
            "x-maxUtf8Bytes": 1000
          },
          "variables": {
            "type": "object",
            "maxProperties": 256,
            "propertyNames": {
              "pattern": "^[A-Za-z_][A-Za-z0-9_.]*$"
            },
            "additionalProperties": {
              "type": "string",
              "x-maxUtf8Bytes": 65536
            },
            "description": "Optional string substitutions overlay template defaults; null/non-string values are rejected."
          },
          "recipients": {
            "type": "array",
            "minItems": 1,
            "maxItems": 50,
            "items": {
              "$ref": "#/components/schemas/Recipient"
            },
            "description": "Must not repeat a canonical role plus case-insensitive email; must satisfy template roles."
          },
          "lawful_basis": {
            "type": "string",
            "description": "Only contract is implemented; leading/trailing whitespace is trimmed.",
            "examples": [
              "contract"
            ]
          },
          "expires_at": {
            "type": "string",
            "format": "date-time",
            "description": "Optional strict RFC3339, uppercase T/Z, at most nine fractional digits, offset at most 23:59. Must be more than five minutes ahead at send; canonicalized to UTC."
          },
          "template_version": {
            "type": "integer",
            "minimum": 1,
            "maximum": 2147483647,
            "description": "Version from the reviewed canonical template response; mismatch returns 412."
          },
          "template_content_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$",
            "description": "Exact content digest from the reviewed canonical template response; mismatch returns 412."
          }
        }
      },
      "Recipient": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "email",
          "name"
        ],
        "properties": {
          "role": {
            "type": "string",
            "default": "signer",
            "description": "Canonical role matches ^[a-z][a-z0-9_-]{0,63}$, excluding cc/viewer. Input is trimmed and lowercased. Must match template signing roles."
          },
          "email": {
            "type": "string",
            "description": "Simple email address without display name; trimmed; at most 254 UTF-8 bytes.",
            "x-maxUtf8Bytes": 254
          },
          "name": {
            "type": "string",
            "description": "Trimmed nonempty plain text, no control characters; at most 200 runes and 800 UTF-8 bytes.",
            "maxLength": 200,
            "x-maxUtf8Bytes": 800
          },
          "order_index": {
            "type": "integer",
            "format": "int32",
            "minimum": 0,
            "maximum": 1000,
            "default": 0
          },
          "locale": {
            "type": "string",
            "default": "en",
            "description": "Supported reviewed base language or regional tag canonicalized to that base. Unknown/malformed tags rejected."
          }
        }
      },
      "SignatureRequestResult": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "automation_request_id",
          "document_id",
          "status",
          "replayed"
        ],
        "properties": {
          "automation_request_id": {
            "type": "string",
            "format": "uuid"
          },
          "document_id": {
            "type": "string",
            "format": "uuid"
          },
          "status": {
            "type": "string",
            "enum": [
              "sent",
              "in_progress",
              "changes_requested",
              "finalizing",
              "completed",
              "declined",
              "voided",
              "expired"
            ]
          },
          "replayed": {
            "type": "boolean"
          }
        },
        "description": "No signer magic links. Receipt confirms the command result, not inbox delivery or completion of signing."
      },
      "Error": {
        "type": "object",
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "type": "string"
          }
        },
        "additionalProperties": true,
        "description": "Some errors also include supported_tier or upgrade_url. Middleware may return a non-JSON error body; clients must handle status before decoding."
      },
      "PreparedDocumentSend": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "lawful_basis"
        ],
        "properties": {
          "lawful_basis": {
            "type": "string",
            "enum": [
              "contract"
            ]
          },
          "package_send": {
            "$ref": "#/components/schemas/PackageSendObservation"
          }
        }
      },
      "PackageSendObservation": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "expected_updated_at",
          "package_id",
          "generation"
        ],
        "properties": {
          "expected_updated_at": {
            "type": "string",
            "format": "date-time",
            "description": "Exact observed UTC timestamp; never derive a replacement."
          },
          "package_id": {
            "type": "string",
            "format": "uuid"
          },
          "generation": {
            "type": "string",
            "pattern": "^[1-9][0-9]{0,18}$",
            "description": "Exact observed decimal generation, not a JSON number."
          }
        }
      },
      "PackageSendOutcome": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "attempt_id",
          "outcome",
          "reconciliation_required"
        ],
        "properties": {
          "attempt_id": {
            "type": "string",
            "format": "uuid"
          },
          "outcome": {
            "type": "string",
            "enum": [
              "active",
              "completed",
              "unknown"
            ]
          },
          "reconciliation_required": {
            "type": "boolean"
          }
        }
      },
      "PreparedDocumentSendResult": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "document_id",
          "status"
        ],
        "properties": {
          "document_id": {
            "type": "string",
            "format": "uuid"
          },
          "status": {
            "type": "string"
          },
          "package_send": {
            "$ref": "#/components/schemas/PackageSendOutcome"
          }
        },
        "description": "Contains no signer bearer links. sealing is pending, not sent/completed."
      },
      "DocumentMetadata": {
        "type": "object",
        "required": [
          "id",
          "status"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "status": {
            "type": "string",
            "description": "Current lifecycle state; consumers must not infer completion from an unfamiliar state."
          }
        },
        "additionalProperties": true,
        "description": "Document metadata uses the existing organization document response. Additional authored, source and lifecycle fields are extensible."
      },
      "TemplateMetadata": {
        "type": "object",
        "required": [
          "id",
          "source_kind",
          "version"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "source_kind": {
            "type": "string"
          },
          "version": {
            "type": "integer"
          },
          "content_sha256": {
            "type": "string",
            "description": "Canonical content pin when present for the source kind; required by the blocks-template signature-request command."
          }
        },
        "additionalProperties": true
      },
      "DocumentList": {
        "type": "object",
        "properties": {
          "documents": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/DocumentMetadata"
            }
          },
          "total": {
            "type": "integer"
          },
          "limit": {
            "type": "integer"
          },
          "offset": {
            "type": "integer"
          }
        },
        "additionalProperties": true
      },
      "TemplateList": {
        "type": "object",
        "properties": {
          "templates": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/TemplateMetadata"
            }
          },
          "total": {
            "type": "integer"
          },
          "limit": {
            "type": "integer"
          },
          "offset": {
            "type": "integer"
          }
        },
        "additionalProperties": true
      },
      "AttachmentInventory": {
        "type": "object",
        "additionalProperties": true,
        "description": "Exact native attachment inventory. Use its reviewed package observation with Send; see DOCUMENT-ATTACHMENTS-API.md."
      },
      "SendAttempt": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "attempt_id",
          "outcome",
          "retry_authorized"
        ],
        "properties": {
          "attempt_id": {
            "type": "string",
            "format": "uuid"
          },
          "outcome": {
            "type": "string",
            "enum": [
              "active",
              "completed",
              "aborted",
              "not_recorded"
            ]
          },
          "retry_authorized": {
            "type": "boolean",
            "const": false
          }
        }
      }
    }
  }
}
