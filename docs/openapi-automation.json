{
  "openapi": "3.1.1",
  "info": {
    "title": "Hash automation API",
    "version": "1",
    "description": "Machine integration contract for CRM/Reactor signature-request creation. Covers this endpoint only; see API-ROUTES.md for other surfaces."
  },
  "servers": [
    {
      "url": "/"
    }
  ],
  "paths": {
    "/api/automation/v1/signature-requests": {
      "post": {
        "operationId": "createSignatureRequest",
        "summary": "Create and send an idempotent signature request",
        "description": "Organization-wide sender/owner API key must carry write:authoring and write:workflow. Body <=1 MiB, valid UTF-8 JSON; duplicate/unknown members and trailing values rejected. Equivalent replays return the same IDs. Retry ambiguous outcomes, 408/425/429 and retryable 5xx using the identical key and body. Revised ceremonies require new authorization. Current limits: 6000 requests/minute/IP and 600/minute/organization, singleton HTTP process.",
        "security": [
          {
            "BearerKey": []
          },
          {
            "HeaderKey": []
          }
        ],
        "parameters": [
          {
            "in": "header",
            "name": "Idempotency-Key",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1,
              "x-maxUtf8Bytes": 200
            },
            "description": "Exactly one header; 1\u2013200 UTF-8 bytes, no control characters or surrounding whitespace. Namespace by producer/workflow/event; no personal data."
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SignatureRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Equivalent idempotent replay; replayed is true.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SignatureRequestResult"
                }
              }
            }
          },
          "201": {
            "description": "New request created and sent; replayed is false.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SignatureRequestResult"
                }
              }
            }
          },
          "400": {
            "description": "Invalid input/header/expiry/lawful basis.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid key.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "402": {
            "description": "Document quota exhausted.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Role, scope or document-scope denied.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Template or document unavailable.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "Idempotency content collision or lifecycle conflict.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "410": {
            "description": "Deleted request tombstone.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "415": {
            "description": "Unsupported content type.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "422": {
            "description": "Invalid block template.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Dependency temporarily unavailable.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "500": {
            "description": "Unexpected internal failure.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "Rate limit exceeded; retry original key and body after backoff. Body format is middleware-dependent.",
            "headers": {
              "Retry-After": {
                "schema": {
                  "type": "string"
                },
                "description": "Retry delay when provided."
              }
            }
          },
          "412": {
            "description": "Template version or content digest changed since review. Fetch and review the canonical template before retrying."
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "BearerKey": {
        "type": "http",
        "scheme": "bearer",
        "description": "Hash API key; organization-wide sender/owner, write:authoring plus write:workflow."
      },
      "HeaderKey": {
        "type": "apiKey",
        "in": "header",
        "name": "X-API-Key",
        "description": "Alternative to Authorization bearer."
      }
    },
    "schemas": {
      "SignatureRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "template_id",
          "template_version",
          "template_content_sha256",
          "name",
          "recipients",
          "lawful_basis"
        ],
        "properties": {
          "template_id": {
            "type": "string",
            "format": "uuid",
            "description": "Accessible nonzero UUID of a valid block-source template. Whitespace is trimmed."
          },
          "name": {
            "type": "string",
            "description": "Trimmed nonempty plain text without control characters; at most 1000 UTF-8 bytes.",
            "x-maxUtf8Bytes": 1000
          },
          "variables": {
            "type": "object",
            "maxProperties": 256,
            "propertyNames": {
              "pattern": "^[A-Za-z_][A-Za-z0-9_.]*$"
            },
            "additionalProperties": {
              "type": "string",
              "x-maxUtf8Bytes": 65536
            },
            "description": "Optional string substitutions overlay template defaults; null/non-string values are rejected."
          },
          "recipients": {
            "type": "array",
            "minItems": 1,
            "maxItems": 50,
            "items": {
              "$ref": "#/components/schemas/Recipient"
            },
            "description": "Must not repeat a canonical role plus case-insensitive email; must satisfy template roles."
          },
          "lawful_basis": {
            "type": "string",
            "description": "Only contract is implemented; leading/trailing whitespace is trimmed.",
            "examples": [
              "contract"
            ]
          },
          "expires_at": {
            "type": "string",
            "format": "date-time",
            "description": "Optional strict RFC3339, uppercase T/Z, at most nine fractional digits, offset at most 23:59. Must be more than five minutes ahead at send; canonicalized to UTC."
          },
          "template_version": {
            "type": "integer",
            "minimum": 1,
            "maximum": 2147483647,
            "description": "Version from the reviewed canonical template response; mismatch returns 412."
          },
          "template_content_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$",
            "description": "Exact content digest from the reviewed canonical template response; mismatch returns 412."
          }
        }
      },
      "Recipient": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "email",
          "name"
        ],
        "properties": {
          "role": {
            "type": "string",
            "default": "signer",
            "description": "Canonical role matches ^[a-z][a-z0-9_-]{0,63}$, excluding cc/viewer. Input is trimmed and lowercased. Must match template signing roles."
          },
          "email": {
            "type": "string",
            "description": "Simple email address without display name; trimmed; at most 254 UTF-8 bytes.",
            "x-maxUtf8Bytes": 254
          },
          "name": {
            "type": "string",
            "description": "Trimmed nonempty plain text, no control characters; at most 200 runes and 800 UTF-8 bytes.",
            "maxLength": 200,
            "x-maxUtf8Bytes": 800
          },
          "order_index": {
            "type": "integer",
            "format": "int32",
            "minimum": 0,
            "maximum": 1000,
            "default": 0
          },
          "locale": {
            "type": "string",
            "default": "en",
            "description": "Supported reviewed base language or regional tag canonicalized to that base. Unknown/malformed tags rejected."
          }
        }
      },
      "SignatureRequestResult": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "automation_request_id",
          "document_id",
          "status",
          "replayed"
        ],
        "properties": {
          "automation_request_id": {
            "type": "string",
            "format": "uuid"
          },
          "document_id": {
            "type": "string",
            "format": "uuid"
          },
          "status": {
            "type": "string",
            "enum": [
              "sent",
              "in_progress",
              "changes_requested",
              "finalizing",
              "completed",
              "declined",
              "voided",
              "expired"
            ]
          },
          "replayed": {
            "type": "boolean"
          }
        },
        "description": "No signer magic links. Receipt confirms the command result, not inbox delivery or completion of signing."
      },
      "Error": {
        "type": "object",
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "type": "string"
          }
        },
        "additionalProperties": true,
        "description": "Some errors also include supported_tier or upgrade_url. Middleware may return a non-JSON error body; clients must handle status before decoding."
      }
    }
  }
}
