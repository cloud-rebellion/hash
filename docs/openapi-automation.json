{
  "openapi": "3.1.1",
  "info": {
    "title": "Hash automation API",
    "version": "1",
    "description": "Vendor-neutral organization machine API for prepared documents, signature requests, lifecycle status and completed artifacts. No CRM, Reactor, browser session or MCP connection is required. See AUTOMATION-API.md for lifecycle and reconciliation rules."
  },
  "servers": [
    {
      "url": "/"
    }
  ],
  "paths": {
    "/api/automation/v1/signature-requests": {
      "post": {
        "operationId": "createSignatureRequest",
        "summary": "Create and send an idempotent signature request",
        "description": "Organization-wide sender/owner API key must carry write:authoring and write:workflow. Body <=1 MiB, valid UTF-8 JSON; duplicate/unknown members and trailing values rejected. Equivalent replays return the same IDs. Retry ambiguous outcomes, 408/425/429 and retryable 5xx using the identical key and body. Revised ceremonies require new authorization. Current limits: 6000 requests/minute/IP and 600/minute/organization, singleton HTTP process.",
        "security": [
          {
            "BearerKey": []
          },
          {
            "HeaderKey": []
          }
        ],
        "parameters": [
          {
            "in": "header",
            "name": "Idempotency-Key",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1,
              "x-maxUtf8Bytes": 200
            },
            "description": "Exactly one header; 1\u2013200 UTF-8 bytes, no control characters or surrounding whitespace. Namespace by producer/workflow/event; no personal data."
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SignatureRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Equivalent idempotent replay; replayed is true.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SignatureRequestResult"
                }
              }
            }
          },
          "201": {
            "description": "New request created and sent; replayed is false.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SignatureRequestResult"
                }
              }
            }
          },
          "400": {
            "description": "Invalid input/header/expiry/lawful basis.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid key.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "402": {
            "description": "Document quota exhausted.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Role, scope or document-scope denied.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Template or document unavailable.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "Idempotency content collision or lifecycle conflict.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "410": {
            "description": "Deleted request tombstone.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "415": {
            "description": "Unsupported content type.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "422": {
            "description": "Invalid block template.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Dependency temporarily unavailable.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "500": {
            "description": "Unexpected internal failure.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "Rate limit exceeded; retry original key and body after backoff. Body format is middleware-dependent.",
            "headers": {
              "Retry-After": {
                "schema": {
                  "type": "string"
                },
                "description": "Retry delay when provided."
              }
            }
          },
          "412": {
            "description": "Template version or content digest changed since review. Fetch and review the canonical template before retrying."
          }
        }
      }
    },
